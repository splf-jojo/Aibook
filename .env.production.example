# Public address of the web app and API. Its DNS A record must point to ECS.
API_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

# Use URL-safe random values, for example: openssl rand -hex 32
POSTGRES_DB=aibook
POSTGRES_USER=aibook
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
JWT_SECRET=replace-with-128-random-hex-characters
ACCESS_TOKEN_MINUTES=10080

# Comma-separated browser origins. Native Swift clients do not use CORS.
CORS_ORIGINS=https://app.example.com

API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
